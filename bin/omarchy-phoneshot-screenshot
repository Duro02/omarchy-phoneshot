#!/bin/bash
# omarchy-phoneshot-screenshot — 可选接管 PRINT 的拍屏 wrapper
# 开关关时: 原样透传给 omarchy-capture-screenshot,行为与原生一致
# 开关开时: 选区+grim,按 ~/.config/omarchy/phoneshot-output 决定去向:
#   clipboard=original|phoneshot|none, save_original/save_phoneshot,
#   output_dir, level, notify (缺席=全默认,见 README)
# 用法: omarchy-phoneshot-screenshot [smart|region|windows|fullscreen] [slurp|copy|save]
# 状态: ~/.config/omarchy/phoneshot-mode (on/off), 缺省 off
set -euo pipefail

MODE_FILE="$HOME/.config/omarchy/phoneshot-mode"
MODE="off"
[[ -f $MODE_FILE ]] && MODE="$(cat "$MODE_FILE")"

# 关着就别碰原生行为,直接透传(以后原生升级也不用跟着改)。
# PHONESHOT_FORCE=1 跳过开关判断——面板里的拍摄按钮走这条路,不看 mode。
if [[ ${PHONESHOT_FORCE:-0} != "1" && $MODE != "on" ]]; then
  exec omarchy-capture-screenshot "$@"
fi

# ---- 界面语言: ~/.config/omarchy/phoneshot-lang (zh|en,缺省 en) ----
PS_LANG="en"
[[ -f $HOME/.config/omarchy/phoneshot-lang ]] && PS_LANG="$(cat "$HOME/.config/omarchy/phoneshot-lang")"
tt() { if [[ $PS_LANG == zh* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi }

# ---- 输出配置 ----
OCFG="$HOME/.config/omarchy/phoneshot-output"
WARNS=()
oget() { # oget KEY DEFAULT — 取值,去两端空白,丢行内注释
  local v=""
  if [[ -f $OCFG ]]; then
    v=$(sed -n "s/^$1[[:space:]]*=[[:space:]]*//p" "$OCFG" | tail -1)
    v="${v%%#*}"
    v="$(printf '%s' "$v" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
  fi
  [[ -z $v ]] && v="$2"
  printf '%s' "$v"
}
obool() { # obool OUTVAR VAL DEFAULT LABEL → 0/1 存变量;非法值回默认并记警告
  local -n _o=$1 # 同 shell 调用,警告能带回(禁止 $() 包裹调它)
  local _v
  _v=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  case "$_v" in
    1|true|yes|on) _o=1 ;;
    0|false|no|off) _o=0 ;;
    *) _o=$3; WARNS+=("$(tt "配置项非法已用默认:$4" "invalid $4, default used")") ;;
  esac
}

CLIP="$(oget clipboard phoneshot | tr 'A-Z' 'a-z')"
case "$CLIP" in
  original|phoneshot|none) ;;
  *) WARNS+=("$(tt "clipboard 非法已用默认:phoneshot" "invalid clipboard, default phoneshot")"); CLIP="phoneshot" ;;
esac
obool SAVE_ORIG "$(oget save_original true)" 1 save_original
obool SAVE_PAI "$(oget save_phoneshot true)" 1 save_phoneshot
OUTDIR_CFG="$(oget output_dir "")"
LEVEL_FILE="$(oget level mid)"
case "$LEVEL_FILE" in
  mild|mid|hard) ;;
  *) WARNS+=("$(tt "level 非法已用默认:mid" "invalid level, default mid")"); LEVEL_FILE="mid" ;;
esac
LEVEL="${PHONESHOT_LEVEL:-$LEVEL_FILE}" # 环境变量显式指定优先
obool NOTIFY "$(oget notify true)" 1 notify

[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${OMARCHY_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"
if [[ -n $OUTDIR_CFG ]]; then OUTPUT_DIR="${OUTDIR_CFG/#\~/$HOME}"; fi
mkdir -p "$OUTPUT_DIR"

say() { # say 标题 正文 [额外参数...] — notify 关了就静默
  if [[ $NOTIFY == "1" ]]; then
    omarchy-notification-send "$@" || true
  fi
  return 0
}

pkill slurp && exit 0

# 锁只保选区+grim 这一段:慢渲染/剪贴板/通知都不占锁,否则 wl-copy 常驻会把后面的截图全挡掉。
# (血的教训 2026-09-08:wl-copy 继承锁 fd 常驻,PRINT 再按也静默无事。)
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/omarchy-phoneshot.lock"
if command -v flock >/dev/null; then
  exec 9>"$LOCK_FILE"
  flock -n 9 || { say "$(tt "⚠️ 拍屏忙" "⚠️ Phoneshot busy")" "$(tt "上一次截图选区还没结束,等它选完再按" "Previous selection isn't done — wait for it")"; exit 0; }
fi

SCREENSHOT_EDITOR="${OMARCHY_SCREENSHOT_EDITOR:-tensaku-edit}"
ARGS=()
for arg in "$@"; do
  [[ $arg == --editor=* ]] && SCREENSHOT_EDITOR="${arg#--editor=}" || ARGS+=("$arg")
done
set -- "${ARGS[@]}"

CAP_MODE="${1:-smart}"
PROCESSING="${2:-slurp}"

NO_HW_CURSORS=$(hyprctl getoption cursor:no_hardware_cursors -j | jq '.int')
set_no_hw_cursors() {
  hyprctl eval "hl.config({ cursor = { no_hardware_cursors = $1 } })" &>/dev/null ||
    hyprctl keyword cursor:no_hardware_cursors "$1" &>/dev/null
}
release_freeze() {
  if [[ -n ${FREEZE_PID:-} ]]; then
    kill "$FREEZE_PID" 2>/dev/null || true
    FREEZE_PID=""
  fi
  set_no_hw_cursors "$NO_HW_CURSORS"
}
TMPD=""
cleanup() {
  release_freeze
  [[ -n $TMPD ]] && rm -rf "$TMPD"
}
trap cleanup EXIT

set_no_hw_cursors 0
{ read -r FREEZE_PID; read -r SELECTION; } < <(omarchy-capture-region "$CAP_MODE" --keep-freeze)
[[ -z ${SELECTION:-} ]] && exit 0

# 模板语义(原生对齐)+配置过滤:
# slurp 全按配置;显式 copy 强制不落盘(剪贴板按配置);显式 save 强制不碰剪贴板(存按配置)
SAVE_RAW=$SAVE_ORIG; SAVE_PAI_F=$SAVE_PAI; CLIP_F=$CLIP
case "$PROCESSING" in
  copy) SAVE_RAW=0; SAVE_PAI_F=0 ;;
  save) CLIP_F=none ;;
esac

STAMP="$(date +'%Y-%m-%d_%H-%M-%S')"
TMPD="$(mktemp -d)"
RAW="$OUTPUT_DIR/screenshot-${STAMP}.png"; [[ $SAVE_RAW == "0" ]] && RAW="$TMPD/raw.png"
PAI="$OUTPUT_DIR/screenshot-${STAMP}-phoneshot.jpg"; [[ $SAVE_PAI_F == "0" ]] && PAI="$TMPD/pai.jpg"

grim -g "$SELECTION" "$RAW" || exit 1
# 慢活开始前放锁:渲染/wl-copy/通知都不再挡后面的截图
eval 'exec 9>&-' 2>/dev/null || true
release_freeze # 先解冻再慢慢做旧

phoneshot_one() {
  local src="$1" dst="$2"
  if command -v omarchy-phoneshot-apply >/dev/null; then
    omarchy-phoneshot-apply "$src" "$dst" "$LEVEL"
  else
    "$(dirname "$0")/omarchy-phoneshot-apply" "$src" "$dst" "$LEVEL"
  fi
}

# 做旧版有人要(存盘或进剪贴板)才渲染,否则省下十几秒
NEED_RENDER=0
if [[ $SAVE_PAI_F == "1" || $CLIP_F == "phoneshot" ]]; then NEED_RENDER=1; fi
if [[ $NEED_RENDER == "1" ]]; then phoneshot_one "$RAW" "$PAI"; fi

# 剪贴板(尽力而为:文件已安全,剪贴板失败只记警告)
CLIP_DONE="none"
case "$CLIP_F" in
  phoneshot)
    # 转投 PNG 进剪贴板:shell 剪贴板历史只 watch text+image/png,jpeg 不会被记录;
    # 部分应用也只认 image/png。文件仍存 jpg 不受影响。
    if magick "$PAI" png:- 2>/dev/null | wl-copy --type image/png 2>/dev/null; then CLIP_DONE="phoneshot"; else WARNS+=("$(tt "剪贴板写入失败" "clipboard write failed")"); fi ;;
  original)
    if wl-copy --type image/png <"$RAW" 2>/dev/null; then CLIP_DONE="original"; else WARNS+=("$(tt "剪贴板写入失败" "clipboard write failed")"); fi ;;
esac

# 回显存下来的文件(兼容原生 echo 路径的行规)
if [[ $SAVE_RAW == "1" ]]; then echo "$OUTPUT_DIR/screenshot-${STAMP}.png"; fi
if [[ $SAVE_PAI_F == "1" ]]; then echo "$OUTPUT_DIR/screenshot-${STAMP}-phoneshot.jpg"; fi

# 通知:按实际行为组装,不撒谎
if [[ $SAVE_RAW == "0" && $SAVE_PAI_F == "0" && $CLIP_DONE == "none" ]]; then
  say "$(tt "⚠️ 本次截图未保留" "⚠️ Screenshot discarded")" "$(tt "没存盘也没进剪贴板,检查 phoneshot-output 配置" "Not saved, not copied — check phoneshot-output")"
else
  if [[ $SAVE_PAI_F == "1" || $CLIP_DONE == "phoneshot" ]]; then
    TITLE="$(tt "📸 拍屏已保存" "📸 Phoneshot saved")"
  else
    TITLE="$(tt "📸 截图已保存" "📸 Screenshot saved")"
  fi
  BODY=""
  case "$CLIP_DONE" in
    phoneshot) BODY="$(tt "做旧版已进剪贴板。" "Styled copy in clipboard.")" ;;
    original) BODY="$(tt "原图已进剪贴板。" "Original in clipboard.")" ;;
    *) BODY="$(tt "未进剪贴板。" "Not in clipboard.")" ;;
  esac
  if [[ $SAVE_RAW == "1" && $SAVE_PAI_F == "1" ]]; then
    BODY="${BODY}$(tt "原图与做旧版都在 $(basename "$OUTPUT_DIR") 里。" "Both copies in $(basename "$OUTPUT_DIR").")"
  elif [[ $SAVE_PAI_F == "1" ]]; then
    BODY="${BODY}$(tt "只存了做旧版,原图未保留。" "Styled only; original discarded.")"
  elif [[ $SAVE_RAW == "1" ]]; then
    BODY="${BODY}$(tt "只存了原图,做旧版未保留。" "Original only; styled discarded.")"
  else
    BODY="${BODY}$(tt "未存盘,再复制就没了。" "Not saved — gone after next copy.")"
  fi
  [[ ${#WARNS[@]} -gt 0 ]] && BODY="${BODY} $(tt "注意" "Note"):${WARNS[*]}"
  if [[ $SAVE_PAI_F == "1" ]]; then
    say "$TITLE" "$BODY $(tt "点击编辑做旧版" "Click to edit styled")" --image "$PAI" --exec "$SCREENSHOT_EDITOR" "$PAI"
  elif [[ $SAVE_RAW == "1" ]]; then
    say "$TITLE" "$BODY $(tt "点击编辑原图" "Click to edit original")" --image "$RAW" --exec "$SCREENSHOT_EDITOR" "$RAW"
  else
    say "$TITLE" "$BODY"
  fi
fi
