#!/bin/bash
# omarchy-phoneshot-set — 面板拖动条的后端: 写参数文件 + 重算预览图。
# 用法:
#   omarchy-phoneshot-set <KEY> <VAL>          单键(兼容老调用)
#   omarchy-phoneshot-set ALL KEY=VAL ...      全量(面板用,一次写完渲一次,
#                                            避免快拖多滑杆时单槽 pending 丢键)
# 预览图固定用 mid 预设打底(滑杆之外的维度);PRINT 截图走同一套参数。
set -euo pipefail

PARAMS_FILE="$HOME/.config/omarchy/phoneshot-params"
PLUGIN_DIR="$HOME/.config/omarchy/plugins/duro.phoneshot"
# 预览图必须放 ~/.cache:写进插件目录会触发 shell 的文件监听,
# 每拖一次滑杆就整插件热重载一次(面板闪烁、手感全毁)。
CACHE_DIR="$HOME/.cache/phoneshot"
mkdir -p "$CACHE_DIR"

# 取值范围钳制(跟面板滑杆一致)
write_one() {
  local KEY="$1" VAL="$2"
  case "$KEY" in
    ROTATE)       VAL=$(awk -v v="$VAL" 'BEGIN{ if(v<-5)v=-5; if(v>5)v=5; printf "%.1f", v }') ;;
    KEYSTONE)     VAL=$(awk -v v="$VAL" 'BEGIN{ if(v<-12)v=-12; if(v>12)v=12; printf "%.1f", v }') ;;
    DEFOCUS)      VAL=$(awk -v v="$VAL" 'BEGIN{ if(v<0)v=0; if(v>2)v=2; printf "%.1f", v }') ;;
    MOTION)       VAL=$(awk -v v="$VAL" 'BEGIN{ if(v<0)v=0; if(v>8)v=8; printf "%.1f", v }') ;;
    MOTION_ANGLE) VAL=$(awk -v v="$VAL" 'BEGIN{ while(v<0)v+=180; while(v>=180)v-=180; printf "%.0f", v }') ;;
    *) echo "unknown key: $KEY" >&2; return 1 ;;
  esac
  # 拖影方向缺席时引擎每次随机,会跟面板显示的 30 对不上;首次写 MOTION 时把默认值落盘
  if [[ $KEY == "MOTION" ]] && ! grep -q "^MOTION_ANGLE=" "$PARAMS_FILE" 2>/dev/null; then
    echo "MOTION_ANGLE=30" >>"$PARAMS_FILE"
  fi
  if grep -q "^${KEY}=" "$PARAMS_FILE" 2>/dev/null; then
    sed -i "s/^${KEY}=.*/${KEY}=${VAL}/" "$PARAMS_FILE"
  else
    echo "${KEY}=${VAL}" >>"$PARAMS_FILE"
  fi
}

mkdir -p "$(dirname "$PARAMS_FILE")"
touch "$PARAMS_FILE"
# 老 TILT 键已废弃,顺手清理
sed -i '/^TILT=/d' "$PARAMS_FILE" 2>/dev/null || true

if [[ ${1:-} == "ALL" ]]; then
  shift
  [[ $# -gt 0 ]] || { echo "usage: $0 ALL KEY=VAL ..." >&2; exit 1; }
  for kv in "$@"; do
    [[ $kv == *=* ]] || { echo "bad pair (want KEY=VAL): $kv" >&2; exit 1; }
    write_one "${kv%%=*}" "${kv#*=}" || exit 1
  done
else
  [[ $# -eq 2 ]] || { echo "usage: $0 <KEY> <VAL> | ALL KEY=VAL ..." >&2; exit 1; }
  write_one "$1" "$2"
fi

APPLY="$(command -v omarchy-phoneshot-apply || echo "$(dirname "$0")/omarchy-phoneshot-apply")"
[[ -f $PLUGIN_DIR/sample.png ]] || { echo "no sample.png" >&2; exit 1; }
"$APPLY" "$PLUGIN_DIR/sample.png" "$CACHE_DIR/preview.jpg" mid
