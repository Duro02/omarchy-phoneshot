#!/bin/bash
# omarchy-phoneshot-toggle — 拍屏接管开关
# 用法: omarchy-phoneshot-toggle [on|off|toggle] (缺省 toggle)
set -euo pipefail

MODE_FILE="$HOME/.config/omarchy/phoneshot-mode"
mkdir -p "$(dirname "$MODE_FILE")"

# 界面语言: ~/.config/omarchy/phoneshot-lang (zh|en,缺省 en)
PS_LANG="en"
[[ -f $HOME/.config/omarchy/phoneshot-lang ]] && PS_LANG="$(cat "$HOME/.config/omarchy/phoneshot-lang")"
tt() { if [[ $PS_LANG == zh* ]]; then printf '%s' "$1"; else printf '%s' "$2"; fi }

cur="off"
[[ -f $MODE_FILE ]] && cur="$(cat "$MODE_FILE")"

case "${1:-toggle}" in
  on)  next="on" ;;
  off) next="off" ;;
  *)   [[ $cur == "on" ]] && next="off" || next="on" ;;
esac

echo -n "$next" >"$MODE_FILE"

if [[ $next == "on" ]]; then
  omarchy-notification-send "$(tt "📸 拍屏模式:开" "📸 Phoneshot: ON")" \
    "$(tt "PRINT 截图会自动做旧成模糊拍屏感" "PRINT screenshots get the phone-photo look")" -t 2500 || true
else
  omarchy-notification-send "$(tt "📸 拍屏模式:关" "📸 Phoneshot: OFF")" \
    "$(tt "PRINT 恢复原生清晰截图" "PRINT is back to crisp native screenshots")" -t 2500 || true
fi
echo "$next"
