#!/bin/bash
# omarchy-paiping-apply v2 — 手机拍屏幕效果
# 做法参考: CRT shader 社区配方(crt-fx: scanlines/phosphor/chromatic/bloom/vignette)
#           + silentMoire 的人工摩尔纹思路(叠加错位细网格再重采样)
# 用法: omarchy-paiping-apply <input> <output> [mild|mid|hard]
# 面板参数(优先级: LEVEL预设 < 参数文件 < 环境变量):
#   ROTATE       面内旋转,单位度,正=逆时针/负=顺时针,确定性 (0=摆正)
#   KEYSTONE     水平侧视,单位度,正=从右侧拍/负=从左侧拍,近侧拉高远侧压缩 (0=正对)
#   DEFOCUS      失焦模糊 sigma (0=实焦)
#   MOTION       手抖拖影长度 px (0=关)
#   MOTION_ANGLE 拖影方向角度 (空=每次随机)
# 参数文件: ~/.config/omarchy/paiping-params (KEY=VALUE,面板拖动条维护,PRINT截图同样生效)
# 分辨率归一:滑杆单位 = 768px 参考宽度下的 px;引擎按 S=W/768 自动换算
# (失焦σ/拖影/摩尔间距/光栅周期/扫描线周期/色散),面板预览(768)与 4K 终图观感一致。
# ROTATE(度)/KEYSTONE(比例)/横带/噪点本身无量纲或已相对化,不受影响。
set -euo pipefail

IN="${1:?usage: $0 <input> <output> [mild|mid|hard]}"
OUT="${2:?usage: $0 <input> <output> [mild|mid|hard]}"
LEVEL="${3:-${PAIPING_LEVEL:-mid}}"

command -v magick >/dev/null || { echo "need ImageMagick (magick)" >&2; exit 1; }
[[ -f $IN ]] || { echo "input not found: $IN" >&2; exit 1; }

W=$(identify -format '%w' "$IN")
H=$(identify -format '%h' "$IN")
((W * H < 400)) && { cp "$IN" "$OUT"; exit 0; }

S=$(awk -v w="$W" 'BEGIN{ s=w/768; if(s<0.5)s=0.5; if(s>6)s=6; printf "%.3f", s }')

case "$LEVEL" in
  mild) MOIRE=16; GRILLE=0.06; SCAN=0.05; CHROMA=1; BLUR="0x0.5"; NOISE=0.10; SAT=95; QUALITY=88 ;;
  hard) MOIRE=42; GRILLE=0.14; SCAN=0.12; CHROMA=2; BLUR="0x1.2"; NOISE=0.25; SAT=86; QUALITY=78 ;;
  *)    MOIRE=28; GRILLE=0.10; SCAN=0.08; CHROMA=1; BLUR="0x0.8"; NOISE=0.16; SAT=91; QUALITY=84 ;;
esac

# ---- 面板参数覆盖:预设 < 参数文件 < 环境变量 ----
PARAMS_FILE="${HOME}/.config/omarchy/paiping-params"
pget() { # pget KEY fallback — 只认白名单内的整行 KEY=VALUE
  local v=""
  [[ -f $PARAMS_FILE ]] && v=$(sed -n "s/^$1=//p" "$PARAMS_FILE" | tail -1)
  [[ -z $v ]] && v="$2"
  printf '%s' "$v"
}
DEFOCUS="${BLUR#0x}" # 预设里的 blur sigma 即默认失焦量
ROTATE="$(pget ROTATE 0)"
KEYSTONE="$(pget KEYSTONE 0)"
DEFOCUS="$(pget DEFOCUS "$DEFOCUS")"
MOTION="$(pget MOTION 0)"
MOTION_ANGLE="$(pget MOTION_ANGLE "")"
[[ -n ${PAIPING_ROTATE:-} ]] && ROTATE="$PAIPING_ROTATE"
[[ -n ${PAIPING_KEYSTONE:-} ]] && KEYSTONE="$PAIPING_KEYSTONE"
[[ -n ${PAIPING_DEFOCUS:-} ]] && DEFOCUS="$PAIPING_DEFOCUS"
[[ -n ${PAIPING_MOTION:-} ]] && MOTION="$PAIPING_MOTION"
[[ -n ${PAIPING_MOTION_ANGLE:-} ]] && MOTION_ANGLE="$PAIPING_MOTION_ANGLE"
BLUR="0x$(awk -v d="$DEFOCUS" -v s="$S" 'BEGIN{ printf "%.2f", d*s }')"

# 失焦联动压摩尔:糊了就看不见像素结构了,摩尔随失焦自动衰减(物理,不是品味)
MOIRE=$(awk -v m="$MOIRE" -v d="$DEFOCUS" 'BEGIN{ f=1-d/2.5; if(f<0.2)f=0.2; printf "%d", m*f }')

# 手抖拖影:方向性 motion blur,角度缺省每次随机(哪次手抖方向都不一样)
MOTION_ARGS=()
if awk -v m="$MOTION" 'BEGIN{ exit !(m>=0.5) }'; then
  [[ -z $MOTION_ANGLE ]] && MOTION_ANGLE=$((RANDOM % 180))
  MOTION_SIG=$(awk -v m="$MOTION" -v s="$S" 'BEGIN{ printf "%.1f", m*s/2 }')
  MOTION_ARGS=(-motion-blur "0x${MOTION_SIG}+${MOTION_ANGLE}")
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
W2=$((W * 2)); H2=$((H * 2))
# 大图限幅:4K 全屏的 2x 画布(7680x4320)要跑一分钟,压到 2400 宽以内,摩尔纹照样出
if ((W2 > 2400)); then H2=$((H2 * 2400 / W2)); W2=2400; fi

# ---- 1. 摩尔层: 中灰底上直接画错位斜线(2x),point抽回后混叠出大尺度波纹 ----
# 注:不用 tile+rotate,rotate大画布慢 5s+,直接画线 <2s。每次随机转角,张张不一样。
ANG_H=$((5 + RANDOM % 6)); ANG_V=$((-4 - RANDOM % 5))
# 画布是 2x,输出间距 2.3px@768 基准(相对密度恒定);后模糊同比换算
SP_C=$(awk -v s="$S" -v w2="$W2" -v w="$W" 'BEGIN{ printf "%.2f", 2.3*s*w2/w }')
MOIRE_BLUR=$(awk -v s="$S" 'BEGIN{ printf "%.2f", 0.6*s }')
awk -v W=$W2 -v H=$H2 -v A=$ANG_H -v SP="$SP_C" 'BEGIN{
  dx=W*sin(A*3.14159/180); y=-H*0.2
  while(y<H*1.2){printf "line 0,%f %d,%f\n", y, W, y+dx; y+=SP}}' >"$TMP/h.mvg"
awk -v W=$W2 -v H=$H2 -v A=$ANG_V -v SP="$SP_C" 'BEGIN{
  dx=H*sin(A*3.14159/180); x=-W*0.2
  while(x<W*1.2){printf "line %f,0 %f,%d\n", x, x+dx, H; x+=SP}}' >"$TMP/v.mvg"
magick -size ${W2}x${H2} xc:"#808080" -fill black \
  -draw "@$TMP/h.mvg" -draw "@$TMP/v.mvg" \
  -filter point -resize ${W}x${H}\! -filter Mitchell -blur 0x$MOIRE_BLUR "$TMP/moire.png"

# ---- 2. LCD亚像素光栅(RGB竖条) ----
GRILLE_P=$(awk -v s="$S" 'BEGIN{ p=int(3*s+0.5); if(p<3)p=3; print p }')
magick -size 1x1 xc:red xc:lime xc:blue +append -scale ${GRILLE_P}x1 "$TMP/grille-tile.png"
magick -size ${W}x${H} tile:"$TMP/grille-tile.png" -alpha set -channel A \
  -evaluate multiply "$GRILLE" +channel "$TMP/grille.png"

# ---- 3. 扫描线mask ----
SCAN_P=$(awk -v s="$S" 'BEGIN{ p=int(4*s+0.5); if(p<4)p=4; print p }')
magick -size ${W}x${SCAN_P} xc:black -fill white -draw "rectangle 0,0 $W,$((SCAN_P/2))" -scale ${W}x${H}\! \
  -alpha set -channel A -evaluate multiply "$SCAN" +channel "$TMP/scanmask.png"

# ---- 4. 快门横带(刷新率失配的那一道亮/暗带): 随机位置柔边横带 ----
BAND_Y=$((H / 4 + RANDOM % (H / 2)))
BAND_H=$((H / 5))
magick -size ${W}x${H} xc:black -fill white \
  -draw "roundrectangle 0,$BAND_Y $W,$((BAND_Y + BAND_H)) 0,0" \
  -blur 0x$((BAND_H / 3)) -alpha set -channel A -evaluate multiply 0.10 +channel "$TMP/band.png"

WORK="$TMP/work.png"
cp "$IN" "$WORK"

# 侧视:水平 yaw,近侧边缘拉高、远侧压缩+内收。正=从右侧拍,负=从左侧拍。
# 先做透视(投影),再做旋转(相机平面内 roll),顺序即真实成像顺序。
if awk -v k="$KEYSTONE" 'BEGIN{ exit !(k < -0.01 || k > 0.01) }'; then
  MAP=$(awk -v W="$W" -v H="$H" -v d="$KEYSTONE" 'BEGIN{
    a = H*0.01*d; c = W*0.004*d
    printf "0,0 %g,%g %d,0 %d,%g 0,%d %g,%g %d,%d %d,%g", c, a, W, W, -a, H, c, H-a, W, H, W, H+a }')
  magick "$WORK" -background black -distort Perspective "$MAP" \
    +repage -gravity center -crop ${W}x${H}+0+0 +repage "$WORK"
fi

# 旋转:整图面内 roll,正=逆时针(跟 QML rotation 反号,代理层取反),转出画布的角填黑后居中裁回。
# 确定性:符号即方向,不再随机,面板代理预览与终图一致。
if awk -v r="$ROTATE" 'BEGIN{ exit !(r >= 0.25 || r <= -0.25) }'; then
  ANG=$(awk -v r="$ROTATE" 'BEGIN{ printf "%.2f", r }')
  magick "$WORK" -background black -distort SRT "$ANG" \
    -gravity center -crop ${W}x${H}+0+0 +repage "$WORK"
fi

CHROMA_S=$(awk -v c="$CHROMA" -v s="$S" 'BEGIN{ p=int(c*s+0.5); if(p<1)p=1; print p }')

magick "$WORK" \
  "$TMP/moire.png" -define compose:args=$MOIRE -compose dissolve -composite \
  "$TMP/grille.png" -compose softlight -composite \
  "$TMP/scanmask.png" -compose multiply -composite \
  -channel R -roll +${CHROMA_S}+0 +channel -channel B -roll -${CHROMA_S}+0 +channel \
  -blur "$BLUR" "${MOTION_ARGS[@]}" -modulate "101,${SAT}" \
  \( -size ${W}x${H} gradient:white-black -rotate 30 -normalize -alpha set -channel A \
     -evaluate multiply 0.06 +channel -fill white -colorize 100% \) -compose screen -composite \
  "$TMP/band.png" -compose screen -composite \
  -attenuate "$NOISE" +noise Gaussian \
  -quality "$QUALITY" "$OUT"
